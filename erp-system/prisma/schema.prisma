// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ============= ENUMS =============
enum UserRole {
  ADMIN
  MANAGER
  USER
  ACCOUNTANT
  VIEWER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AddressType {
  BILLING
  SHIPPING
  OFFICE
  OTHER
}

// ============= TENANT & USER =============
model Tenant {
  id            Int     @id @default(autoincrement())
  business_name String
  email         String  @unique
  gst_number    String?
  pan_number    String?
  status        String  @default("ACTIVE")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  users                User[]
  organization         Organization?
  customers            Customer[]
  seller_profiles      SellerProfile[]
  invoice_customer_profiles InvoiceCustomerProfile[]
  products             Product[]
  invoices             Invoice[]
  payments             Payment[]
  addresses            Address[]
  gst_rates            GstRate[]
  suppliers            Supplier[]
  purchase_orders      PurchaseOrder[]
  expenses             Expense[]
  stock_transfers      StockTransfer[]
  inventory            Inventory[]
  product_categories   ProductCategory[]
  expense_categories   ExpenseCategory[]
  
  @@index([email])
}

model SellerProfile {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  business_name String
  contact_name  String
  email         String?
  phone         String?
  gst_number    String?
  pan_number    String?
  address       String?
  city          String?
  state         String?
  postal_code   String?
  country       String  @default("India")
  bank_account  String?
  ifsc_code     String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tenant        Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  invoices      Invoice[] @relation("InvoiceSellerProfile")

  @@index([tenant_id])
}

model InvoiceCustomerProfile {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  customer_name String
  company_name  String?
  email         String?
  phone         String?
  gst_number    String?
  pan_number    String?
  address       String?
  city          String?
  state         String?
  postal_code   String?
  country       String  @default("India")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tenant        Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  invoices      Invoice[] @relation("InvoiceCustomerProfile")

  @@index([tenant_id])
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String
  password  String
  role      UserRole @default(USER)
  tenant_id Int
  tenant    Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  
  @@index([tenant_id])
}

// ============= ORGANIZATION =============
model Organization {
  id            Int     @id @default(autoincrement())
  tenant_id     Int     @unique
  name          String
  email         String
  phone         String?
  gst_number    String? @unique
  pan_number    String? @unique
  cin_number    String? // Corporate Identification Number
  bank_account  String?
  ifsc_code     String?
  status        String  @default("ACTIVE")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  addresses     Address[] @relation("AddressToOrganization")
  
  @@index([gst_number])
}

// ============= ADDRESS =============
model Address {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  customer_id   Int?
  supplier_id   Int?
  organization_id Int?
  
  street        String
  street2       String?
  city          String
  state         String
  postal_code   String
  country       String  @default("India")
  address_type  AddressType @default(BILLING)
  is_primary    Boolean @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer      Customer?  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  supplier      Supplier?  @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  organization  Organization? @relation("AddressToOrganization", fields: [organization_id], references: [id], onDelete: Cascade)
  
  @@index([tenant_id])
  @@index([customer_id])
  @@index([supplier_id])
  @@index([organization_id])
}

// ============= CUSTOMER =============
model Customer {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  name          String
  email         String?
  phone         String?
  mobile        String?
  gst_number    String?
  pan_number    String?
  credit_limit  Float   @default(0)
  payment_terms String? // e.g., "NET 30", "NET 60"
  status        CustomerStatus @default(ACTIVE)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  addresses     Address[]
  invoices      Invoice[]
  payments      Payment[]
  
  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@index([gst_number])
}

// ============= PRODUCT CATEGORY =============
model ProductCategory {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  name          String
  description   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products      Product[]
  
  @@unique([tenant_id, name])
  @@index([tenant_id])
}

// ============= UNIT OF MEASURE =============
model UnitOfMeasure {
  id            Int     @id @default(autoincrement())
  name          String  @unique // e.g., "KG", "LITER", "PIECE", "METER"
  symbol        String  @unique
  created_at    DateTime @default(now())
  
  products      Product[]
}

// ============= GST RATE =============
model GstRate {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  percentage    Float   // e.g., 5, 12, 18, 28
  name          String  // e.g., "GST 5%", "GST 18%"
  description   String?
  is_active     Boolean @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products      Product[]
  invoice_items InvoiceItem[]
  
  @@unique([tenant_id, percentage])
  @@index([tenant_id])
}

// ============= PRODUCT =============
model Product {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  sku           String
  name          String
  description   String?
  category_id   Int?
  supplier_id   Int?
  unit_id       Int
  cost_price    Float
  selling_price Float
  quantity_in_stock Int @default(0)
  reorder_level Int   @default(0)
  gst_rate_id   Int
  status        ProductStatus @default(ACTIVE)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category      ProductCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  supplier      Supplier?       @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  unit           UnitOfMeasure   @relation(fields: [unit_id], references: [id])
  gst_rate      GstRate         @relation(fields: [gst_rate_id], references: [id])
  invoice_items InvoiceItem[]
  inventory     Inventory?
  stock_transfers StockTransfer[]
  
  @@unique([tenant_id, sku])
  @@index([tenant_id])
  @@index([category_id])
  @@index([supplier_id])
}

// ============= SUPPLIER =============
model Supplier {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  name          String
  email         String?
  phone         String?
  gst_number    String?
  pan_number    String?
  payment_terms String?
  status        CustomerStatus @default(ACTIVE)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  addresses     Address[]
  products      Product[]
  purchase_orders PurchaseOrder[]
  
  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@index([gst_number])
}

// ============= INVENTORY =============
model Inventory {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  product_id    Int     @unique
  quantity_available Int
  quantity_reserved  Int @default(0)
  quantity_damaged   Int @default(0)
  last_stock_update DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  @@index([tenant_id])
  @@index([product_id])
}

// ============= STOCK TRANSFER =============
model StockTransfer {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  product_id    Int
  transfer_type String  // INBOUND, OUTBOUND, ADJUSTMENT
  quantity      Int
  reference_type String? // e.g., PURCHASE_ORDER, INVOICE, ADJUSTMENT
  reference_id  Int?
  notes         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  @@index([tenant_id])
  @@index([product_id])
  @@index([created_at])
}

// ============= INVOICE =============
model Invoice {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  customer_id   Int
  invoice_number String
  invoice_date  DateTime @default(now())
  due_date      DateTime?
  status        InvoiceStatus @default(DRAFT)
  subtotal      Float   @default(0)
  tax_amount    Float   @default(0)
  total_amount  Float   @default(0)
  notes         String?
  terms         String?
  created_by    Int     // User ID
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  seller_profile_id Int?
  customer_profile_id Int?
  seller_profile SellerProfile? @relation("InvoiceSellerProfile", fields: [seller_profile_id], references: [id], onDelete: SetNull)
  customer_profile InvoiceCustomerProfile? @relation("InvoiceCustomerProfile", fields: [customer_profile_id], references: [id], onDelete: SetNull)
  line_items    InvoiceItem[]
  payments      Payment[]
  
  @@unique([tenant_id, invoice_number])
  @@index([tenant_id])
  @@index([customer_id])
  @@index([invoice_date])
  @@index([status])
}

// ============= INVOICE ITEM =============
model InvoiceItem {
  id            Int     @id @default(autoincrement())
  invoice_id    Int
  product_id    Int
  gst_rate_id   Int
  quantity      Float
  unit_price    Float
  subtotal      Float  // quantity * unit_price
  tax_amount    Float
  total_amount  Float  // subtotal + tax
  description   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  invoice       Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  gst_rate      GstRate @relation(fields: [gst_rate_id], references: [id])
  
  @@index([invoice_id])
  @@index([product_id])
}

// ============= PAYMENT =============
model Payment {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  invoice_id    Int?
  customer_id   Int
  payment_amount Float
  payment_date  DateTime @default(now())
  payment_method String  // e.g., "CASH", "CHEQUE", "BANK_TRANSFER", "CREDIT_CARD"
  reference_number String?
  notes         String?
  status        PaymentStatus @default(PENDING)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  invoice       Invoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  customer      Customer @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  
  @@index([tenant_id])
  @@index([customer_id])
  @@index([invoice_id])
  @@index([payment_date])
}

// ============= PURCHASE ORDER =============
model PurchaseOrder {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  supplier_id   Int
  po_number     String
  po_date       DateTime @default(now())
  expected_delivery DateTime?
  actual_delivery DateTime?
  status        String  @default("DRAFT") // DRAFT, SENT, RECEIVED, CANCELLED
  subtotal      Float   @default(0)
  tax_amount    Float   @default(0)
  total_amount  Float   @default(0)
  notes         String?
  created_by    Int     // User ID
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  
  @@unique([tenant_id, po_number])
  @@index([tenant_id])
  @@index([supplier_id])
}

// ============= EXPENSE CATEGORY =============
model ExpenseCategory {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  name          String
  description   String?
  created_at    DateTime @default(now())
  
  tenant        Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  expenses      Expense[]
  
  @@unique([tenant_id, name])
  @@index([tenant_id])
}

// ============= EXPENSE =============
model Expense {
  id            Int     @id @default(autoincrement())
  tenant_id     Int
  category_id   Int
  description   String
  amount        Float
  expense_date  DateTime @default(now())
  created_by    Int     // User ID
  attachment_url String?
  notes         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  tenant        Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [category_id], references: [id], onDelete: Restrict)
  
  @@index([tenant_id])
  @@index([category_id])
  @@index([expense_date])
}



